[18.822821, "o", "NAME:\r\n"]
[18.823014, "o", "   hexlet-path-size - print size of a file or directory\r\n\r\nUSAGE:\r\n   hexlet-path-size [global options] <path>\r\n\r\nGLOBAL OPTIONS:\r\n"]
[18.823094, "o", "   --human, -H      human-readable sizes (auto-select unit)\r\n   --all, -a        include hidden files and directories\r\n   --recursive, -r  recursive size of directories\r\n   --help, -h       show help\r\n"]
